  "status_dictionary": [
    {
      "key": "采纳",
      "description": "已确定要做（不一定立项，但方向锁定）。",
      "color_token": "high",
      "requires_wakeup": false,
      "shown_in_next_report": false,
      "extra": "需填 owning_team；移交对应小组后不再在日报推。"
    },
    {
      "key": "跟进",
      "description": "当下持续观察 + 调研。",
      "color_token": "info",
      "requires_wakeup": false,
      "shown_in_next_report": true,
      "extra": "每期日报必现，有新输入则进 C 区。"
    },
    {
      "key": "部分采纳",
      "description": "一条信号拆成两个方向，部分采纳 + 部分 defer。",
      "color_token": "mid",
      "requires_wakeup": false,
      "shown_in_next_report": true
    },
    {
      "key": "保留",
      "description": "方向认可但当下不动，挂『唤醒条件』进唤醒池。",
      "color_token": "purple",
      "requires_wakeup": true,
      "shown_in_next_report": false,
      "extra": "唤醒条件中任一命中即从『保留』回流到当期『今日可做』。"
    },
    {
      "key": "忽略",
      "description": "已否决（结构劣势 / 时序错位 / 已在做 等等）。",
      "color_token": "low",
      "requires_wakeup": false,
      "shown_in_next_report": false
    },
    {
      "key": "待反馈",
      "description": "首次出现尚未表态，下期会复现。两期内必须明确为其他 status。",
      "color_token": "warn",
      "requires_wakeup": false,
      "shown_in_next_report": true
    }
  ],

